{
  "name": "@confluxjs/create-conflux",
  "version": "0.1.1",
  "description": "Scaffold a new Conflux bot project",
  "keywords": [
    "conflux",
    "fluxer",
    "bot",
    "create",
    "scaffold",
    "cli"
  ],
  "homepage": "https://conflux.js.org",
  "bugs": "https://github.com/maybeizen/confluxjs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maybeizen/confluxjs.git",
    "directory": "packages/create-conflux"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-conflux": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsdown --watch",
    "lint": "eslint src",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.1",
    "validate-npm-package-name": "^6.0.0"
  },
  "devDependencies": {
    "@confluxjs/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "tsdown": "catalog:build",
    "typescript": "catalog:build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
